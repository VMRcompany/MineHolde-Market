rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVipOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vovaryzanov2@gmail.com' ||
        request.auth.token.email == 'vovaryzanov5@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User accounts collection with highest synchronization degree for VIP
    match /users/{userId} {
      allow read: if isOwner(userId) || isVipOrAdmin();
      allow write: if isOwner(userId) || isVipOrAdmin();
    }

    // Marketplace Products dynamic collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isVipOrAdmin();
    }

    // Settings and metadata collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isVipOrAdmin();
    }
  }
}
