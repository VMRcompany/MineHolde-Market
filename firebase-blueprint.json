{
  "entities": {
    "users": {
      "title": "User Profile & Market Data",
      "description": "Stores user coins, inventory, wishlist, and download history synced across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "Full name or display name" },
        "firstName": { "type": "string", "description": "First name" },
        "lastName": { "type": "string", "description": "Last name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "coins": { "type": "number", "description": "MineHolde coins balance, defaults to 0" },
        "inventory": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of purchased product IDs"
        },
        "wishlist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of wishlist product IDs"
        },
        "downloadedPacks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "type": "string" },
              "downloadedAt": { "type": "string" }
            }
          },
          "description": "List of downloaded skinpacks and mods"
        },
        "updatedAt": { "type": "string", "description": "Timestamp ISO string" }
      },
      "required": ["id", "coins"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "users",
      "description": "User specific settings and sync data"
    }
  }
}
